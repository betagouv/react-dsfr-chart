#!/bin/sh
# Refuse un commit qui contient un secret.
# Installation : npm run hooks:install
# Gitleaks : brew install gitleaks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit : gitleaks est absent, la recherche de secrets est ignorée."
  echo "             brew install gitleaks"
  exit 0
fi

gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Un secret se trouve dans les fichiers indexés. Le commit est refusé."
  echo "Retirez le secret, puis révoquez-le s'il a déjà existé."
fi

exit $status
